# Flutter Environment Variables
# Flutter does NOT use .env files at runtime. Values are injected at compile time via --dart-define.

# Build with custom API URL:
# flutter build apk --release --dart-define=API_BASE_URL=https://sigap.live

# ─── Compile-time environment variables ───────────────────────────────────────
# These are set via --dart-define when building/running the Flutter app.

# API Base URL (required for API calls)
# Default: http://localhost:8787 (local wrangler dev)
# Example: --dart-define=API_BASE_URL=http://localhost:8787
API_BASE_URL=http://localhost:8787
